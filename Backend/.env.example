PORT=5000
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
OTP_PEPPER=use_a_long_random_secret_for_hashing_otp_values
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
FCM_SERVICE_ACCOUNT_JSON=your_fcm_service_account_json
GUPSHUP_API_KEY=your_gupshup_api_key
GUPSHUP_APP_NAME=your_gupshup_app_name
GUPSHUP_APP_ID=your_gupshup_app_id
# Optional: account-level portal API key, ONLY needed for the legacy opt-in API
GUPSHUP_OPTIN_API_KEY=
GUPSHUP_SOURCE_PHONE=your_gupshup_whatsapp_business_phone_number
# Reference-only WABA identifiers (not required by the v1 API)
GUPSHUP_WABA_ID=your_waba_id
GUPSHUP_PHONE_NUMBER_ID=your_phone_number_id
# Approved template IDs (leave blank until WhatsApp approves each template)
GUPSHUP_TEMPLATE_OTP=
GUPSHUP_TEMPLATE_INSTALLMENT_DUE=
GUPSHUP_TEMPLATE_PAYMENT_OVERDUE=
GUPSHUP_TEMPLATE_PARTIAL_PAYMENT=
GUPSHUP_TEMPLATE_AUCTION_SCHEDULED=
# Shared secret required (header x-admin-secret) by the admin/scheduler
# routes in server.ts — must match Frontend EXPO_PUBLIC_ADMIN_API_SECRET.
ADMIN_API_SECRET=use_a_long_random_secret
# Required only by the admin seed script and authenticated RLS test.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=use_a_unique_strong_password
# Required only by manual WhatsApp live-send tests.
TEST_DESTINATION=
TEST_CUSTOMER_PHONE=
LOCAL_STATUS_BASE=http://localhost:5000
# Set to 'true' ONLY by test entrypoints to short-circuit every outbound
# Gupshup call before any network request. NEVER set in the live process.
GUPSHUP_DRY_RUN=
# Shared secret Gupshup must send as ?token= on the webhook callback URL
# (Gupshup doesn't sign payloads). Append to the registered dashboard URL.
GUPSHUP_WEBHOOK_TOKEN=use_a_long_random_secret
# Comma-separated allowlist of browser origins allowed by CORS. Leave empty
# to deny all browser cross-origin access (native app/webhook are unaffected).
ALLOWED_ORIGINS=
